/* ==================================================================== */
/* ADDMISSPC - NEWシステムでAS01に比べ不足している特殊権限を追加する     */
/* 対象: *ALLOBJが不足する1147ユーザー                                  */
/*       (*SAVSYSも不足: QHAUSRPRF, QPGMR)                              */
/* 注意: CHGUSRPRFのSPCAUTは完全な権限リストで上書きされます            */
/*       本プログラムはAS01の権限状態を再現します                        */
/* ==================================================================== */
 PGM

 CHGUSRPRF USER(AXES) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS)
 CHGUSRPRF USER(AXES_GROUP) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USER(BUMON) SPCAUT(*ALLOBJ *SAVSYS *SPLCTL)
 CHGUSRPRF USER(COL) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USER(CSI) +
           SPCAUT(*ALLOBJ *AUDIT *IOSYSCFG *JOBCTL *SAVSYS *SECADM *SERVICE *SPLCTL)
 CHGUSRPRF USER(DB2XML) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USER(DCXPGMLIB) +
           SPCAUT(*ALLOBJ *AUDIT *IOSYSCFG *JOBCTL *SAVSYS *SECADM *SERVICE *SPLCTL)
 CHGUSRPRF USER(DEVELOPER) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS *SECADM *SPLCTL)
 CHGUSRPRF USER(EISUI) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS)
 CHGUSRPRF USER(EISUIX) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS)
 CHGUSRPRF USER(EISUIX#) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USER(EISUIXTEST) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS)
 CHGUSRPRF USER(EOL400) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS)
 CHGUSRPRF USER(HARA) SPCAUT(*ALLOBJ *SAVSYS *SPLCTL)
 CHGUSRPRF USER(HISHO) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USER(HOJO) SPCAUT(*ALLOBJ *SAVSYS *SPLCTL)
 CHGUSRPRF USER(IKUTA) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USER(ISP) SPCAUT(*ALLOBJ *SAVSYS *SECADM *SPLCTL)
 CHGUSRPRF USER(ISPD01) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS *SECADM)
 CHGUSRPRF USER(ISPD02) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS *SECADM)
