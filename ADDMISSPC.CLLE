/* ==================================================================== */
/* ADDMISSPC - NEWシステムでAS01に比べ不足している特殊権限を追加する     */
/* 対象: 1117ユーザー (*ALLOBJが不足, うち2件は*SAVSYSも不足)  */
/* 除外: IBMシステムプロファイル(変更不可) 30件                          */
/* ==================================================================== */
 PGM

 CHGUSRPRF USRPRF(AXES) SPCAUT(*ALLOBJ *JOBCTL *SAVSYS)
 CHGUSRPRF USRPRF(AXES_GROUP) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USRPRF(BUMON) SPCAUT(*ALLOBJ *SAVSYS *SPLCTL)
 CHGUSRPRF USRPRF(COL) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USRPRF(CSI) +
           SPCAUT(*ALLOBJ *AUDIT *IOSYSCFG *JOBCTL *SAVSYS *SECADM *SERVICE *SPLCTL)
 CHGUSRPRF USRPRF(DB2XML) SPCAUT(*ALLOBJ *SAVSYS)
 CHGUSRPRF USRPRF(DCXPGMLIB) +
           SPCAUT(*ALLOBJ *AUDIT *IOSYSCFG *JOBCTL *SAVSYS *SECADM *SERVICE *SPLCTL)
